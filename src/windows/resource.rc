#include <winresrc.h>
#include "../version.h"

#define MAINICON 101

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

MAINICON ICON "syg-icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SYG_VERSION_MAJOR,SYG_VERSION_MINOR,SYG_VERSION_PATCH
PRODUCTVERSION SYG_VERSION_MAJOR,SYG_VERSION_MINOR,SYG_VERSION_PATCH

FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "acetone"
            VALUE "FileDescription", "Simple Yggdrasil address miner"
            VALUE "FileVersion", SYG_VERSION
            VALUE "LegalCopyright", "(c) GPLv3"
            VALUE "OriginalFilename", "sygcpp"
            VALUE "ProductName", "SimpleYggGen"
            VALUE "ProductVersion", SYG_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
